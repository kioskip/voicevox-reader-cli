#!/bin/bash
# bin/vvread - voiceClaude CLI entry point (R-004)
#
# 責務: subcommand dispatch のみ。実装は scripts/ 配下の各スクリプト
# (voice.sh / 今後 vvread say 等)に委譲する。R-004 段階では voice.sh
# 既存実装を壊さず exec で繋ぐ。R-005 以降で say / on-stop / synth /
# play 等を順次統合する。
#
# 起動経路:
#   - 直接実行: <repo>/bin/vvread
#   - PATH 経由: ~/.local/bin/vvread → <repo>/bin/vvread への symlink 等
# 後者で repo root を見失わないよう BASH_SOURCE を symlink 解決する。
#
# Bash 3.2 互換 + set -euo pipefail(entry script の方針、doc/08-bash-rules.md)。

set -euo pipefail

# ===== 自身の path を symlink chain ごと解決 =====
# user が `ln -s <repo>/bin/vvread ~/.local/bin/vvread` 形式で入れる前提。
# symlink → symlink → 実体 のチェーンも辿る。
# 注意: 無効 cwd（削除済みディレクトリ等）から実行すると bash プロセス起動時の
#       C 初期化 (getcwd) が失敗し "shell-init: error" が 1 行出る。
#       これはスクリプト実行前の bash 内部処理のため制御不能。動作自体は正常完了。(U-108)
_vvread_source="${BASH_SOURCE[0]}"
while [ -h "${_vvread_source}" ]; do
  _vvread_dir="${_vvread_source%/*}"
  _vvread_source="$(readlink "${_vvread_source}")"
  # symlink target が相対パスなら symlink の置き場所を基準に解決
  case "${_vvread_source}" in
    /*) ;;
    *) _vvread_source="${_vvread_dir}/${_vvread_source}" ;;
  esac
done
case "${_vvread_source}" in
  /*) VVREAD_BIN_DIR="${_vvread_source%/*}" ;;
  *)  VVREAD_BIN_DIR="$(cd -P "$(dirname "${_vvread_source}")" && pwd)" ;;
esac
VVREAD_PROJECT_DIR="${VVREAD_BIN_DIR%/*}"
VVREAD_SCRIPTS_DIR="${VVREAD_PROJECT_DIR}/scripts"

# 後段の subcommand が利用できるよう export する(R-005 以降で参照予定)
export VVREAD_BIN_DIR VVREAD_PROJECT_DIR VVREAD_SCRIPTS_DIR

# ===== usage =====

usage() {
  cat >&2 <<'EOF'
Usage: vvread [<text>] [--speaker N]
       vvread <command> [args...]

発話系（直接テキスト・パイプ対応）:
  <text>                        テキストを読み上げる（位置引数）
  file <path>                   ファイルを読み上げる
  url <url>                     URLのWebページ本文を読み上げる
  say <text>                    テキストを読み上げる（互換形式）
  synth <text> --output FILE    合成のみ。wav を FILE に書き出す
  play <wav>                    既存 wav を再生
  on-stop                       Claude Code Stop hook 用エントリ

制御系:
  stop                          再生中の音を即停止
  mute <duration>               一定時間ミュート (例: 30s, 5m, 2h)
  off                           永続オフ (`vvread on` まで)
  on                            復帰
  status                        現状表示
  clean                         古い一時ファイルを削除

管理系:
  install [--scope SCOPE]       Claude Code hook を現在のプロジェクトに登録（hook のみ。初回は setup 推奨）
  uninstall [--scope SCOPE]     hook 登録解除
  doctor [--offline]            ヘルスチェック
  setup [--engine MODE]         初回セットアップ（Engine 接続確認・依存確認・hook 登録・project settings 作成を一括実行）
  speakers                      利用可能な speaker 一覧を表示
  config [--list]               設定をインタラクティブに編集。--list で全キーと現在値を一覧表示
  edit                          config のエイリアス

ヘルプ:
  -h, --help, help              この usage を表示

注意:
  コマンド名と同じ文字列を読み上げる場合は say を使用:
    vvread say "say"      # "say" というテキスト
    vvread say "doctor"   # "doctor" というテキスト
EOF
}

# ===== subcommand 判定 =====
# NOTE: 新しい subcommand を追加したら必ずここも更新すること
_is_subcommand() {
  case "$1" in
    help|-h|--help|say|synth|play|on-stop|stop|mute|off|on|status|clean|install|uninstall|doctor|setup|speakers|config|edit|file|url)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

# ===== 未実装 stub =====
# 該当 subcommand は将来の R タスクで実装する。本コミット時点では明示的に
# 「未実装」を返す(silent fail させない、CI で発見できるように)。

cmd_not_implemented() {
  local cmd="$1"
  local future="$2"
  printf 'vvread %s: not yet implemented (%s)\n' "${cmd}" "${future}" >&2
  return 2
}

# ===== dispatch =====

# stdin が pipe されているか判定（[ -p /dev/stdin ] で named pipe のみ検出）
# [ -t 0 ] は redirect や /dev/null でも偽になるため、より正確な pipe 判定を使う
_stdin_is_piped=false
if [ -p /dev/stdin ]; then
  _stdin_is_piped=true
fi

if [ $# -eq 0 ]; then
  if ${_stdin_is_piped}; then
    # stdin が piped で引数なし → stdin 読み上げ
    subcommand="__stdin__"
  else
    usage
    exit 1
  fi
else
  subcommand="$1"
  if ${_stdin_is_piped} && ! _is_subcommand "${subcommand}"; then
    # stdin piped + 先頭引数が subcommand でない (--speaker 等) → stdin + say options
    subcommand="__stdin__"
    # shift しない: $@ をそのまま say.sh に渡す
  else
    shift
  fi
fi

case "${subcommand}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  # 制御系: 既存 voice.sh 実装に委譲(R-005+ で本体統合予定)
  stop|mute|off|on|status|clean)
    cd / 2>/dev/null || true
    exec "${VVREAD_SCRIPTS_DIR}/voice.sh" "${subcommand}" "$@"
    ;;
  # 発話系
  __stdin__)
    # stdin から読み上げ。$@ は say options (--speaker 等)
    _stdin_text=$(cat) || true
    # NOTE: $(cat) は末尾改行を削除。読み上げ用途では許容。
    if [ -z "${_stdin_text}" ]; then
      printf 'vvread: stdin is empty\n' >&2
      exit 1
    fi
    exec "${VVREAD_SCRIPTS_DIR}/cmd/say.sh" "${_stdin_text}" "$@"
    ;;
  file)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/file.sh" "$@"
    ;;
  url)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/url.sh" "$@"
    ;;
  say)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/say.sh" "$@"
    ;;
  synth)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/synth.sh" "$@"
    ;;
  play)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/play.sh" "$@"
    ;;
  on-stop)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/on_stop.sh" "$@"
    ;;
  install)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/install.sh" "$@"
    ;;
  uninstall)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/uninstall.sh" "$@"
    ;;
  doctor)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/doctor.sh" "$@"
    ;;
  setup)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/setup.sh" "$@"
    ;;
  speakers)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/speakers.sh" "$@"
    ;;
  config|edit)
    exec "${VVREAD_SCRIPTS_DIR}/cmd/config.sh" "$@"
    ;;
  *)
    if _is_subcommand "${subcommand}"; then
      # _is_subcommand=true なのに case に落ちた = 実装漏れ
      printf 'vvread: %s: not yet implemented\n' "${subcommand}" >&2
      exit 2
    fi
    # subcommand でない → テキストとして say に委譲
    exec "${VVREAD_SCRIPTS_DIR}/cmd/say.sh" "${subcommand}" "$@"
    ;;
esac
